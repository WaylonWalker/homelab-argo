#!/usr/bin/env bash
set -euo pipefail

# Black-box tests for scripts/secrets/external-dns-cloudflare.  The commands
# below are deliberately small fakes: jq remains the real JSON parser.
readonly workflow=${WORKFLOW:-"$(cd "$(dirname "$0")/../.." && pwd)/scripts/secrets/external-dns-cloudflare"}
readonly root=$(mktemp -d)
readonly fake_bin="$root/bin"
readonly token='FAKE-CLOUDFLARE-TOKEN-12345'
cleanup_root() {
  if [[ ${TEST_KEEP_TMP:-false} == true ]]; then
    printf 'Kept test directory: %s\n' "$root" >&2
  else
    rm -rf "$root"
  fi
}
trap cleanup_root EXIT

fail() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }
assert_file() { [[ -f $1 ]] || fail "missing file: $1"; }
assert_contains() { grep -Fq -- "$2" "$1" || fail "$(printf '%s' "$2") not found in $1"; }
assert_not_contains() { ! grep -Fq -- "$2" "$1" || fail "secret found in $1"; }
assert_log_count() {
  local expected=$1 pattern=$2 file=$3 actual
  actual=$(grep -Fc -- "$pattern" "$file" || true)
  [[ $actual == "$expected" ]] || fail "$pattern occurred $actual times, expected $expected"
}

mkdir -p "$fake_bin"
cat >"$fake_bin/kubectl" <<'FAKE_KUBECTL'
#!/usr/bin/env bash
set -euo pipefail
if [[ ${1-} == cluster-info ]]; then
  printf 'Kubernetes control plane is running\n'
elif [[ ${1-} == create && ${2-} == secret ]]; then
  secret=$(< /dev/stdin)
  printf '%s\n' 'apiVersion: v1' 'kind: Secret' 'metadata:' '  name: external-dns-cloudflare' "  token-length: ${#secret}" 'data:' '  api-token: REDACTED'
else
  printf 'unexpected kubectl invocation\n' >&2
  exit 1
fi
FAKE_KUBECTL

cat >"$fake_bin/kubeseal" <<'FAKE_KUBESEAL'
#!/usr/bin/env bash
set -euo pipefail
if [[ ${1-} == --fetch-cert ]]; then
  printf '%s\n' 'fake-sealed-secrets-certificate'
elif [[ ${1-} == --validate ]]; then
  input=$(< /dev/stdin)
  [[ $input == *'kind: SealedSecret'* ]] || exit 1
else
  input=$(< /dev/stdin)
  [[ $input == *'kind: Secret'* ]] || exit 1
  # The token must never be emitted by the sealing command.
  printf '%s\n' 'apiVersion: bitnami.com/v1alpha1' 'kind: SealedSecret' 'metadata:' '  name: external-dns-cloudflare' '  namespace: external-dns' 'spec:' '  encryptedData:' '    api-token: FAKE-CIPHERTEXT'
fi
FAKE_KUBESEAL

cat >"$fake_bin/wl-paste" <<'FAKE_WL_PASTE'
#!/usr/bin/env bash
set -euo pipefail
printf '%s' "$TEST_TOKEN"
FAKE_WL_PASTE

cat >"$fake_bin/wl-copy" <<'FAKE_WL_COPY'
#!/usr/bin/env bash
set -euo pipefail
printf 'clear\n' >>"$TEST_STATE/clipboard.log"
FAKE_WL_COPY

cat >"$fake_bin/xdg-open" <<'FAKE_XDG_OPEN'
#!/usr/bin/env bash
exit 1
FAKE_XDG_OPEN

cat >"$fake_bin/curl" <<'FAKE_CURL'
#!/usr/bin/env bash
set -euo pipefail
method=GET config='' url=''
while (($#)); do
  case $1 in
    -X) method=$2; shift 2 ;;
    --config) config=$2; shift 2 ;;
    http*) url=$1; shift ;;
    *) shift ;;
  esac
done
path=${url#https://api.cloudflare.com/client/v4}
printf '%s %s\n' "$method" "$path" >>"$TEST_STATE/curl.log"

if [[ $path == /user/tokens/verify ]]; then
  printf '%s\n' '{"success":true,"result":{"status":"active"}}'
elif [[ $path == /zones\?per_page=100\&page=1 ]]; then
  printf '%s\n' '{"success":true,"result":[{"name":"waylonwalker.com","id":"zone-waylon"},{"name":"rhiannonwalker.com","id":"zone-rhiannon"}],"result_info":{"total_pages":2}}'
elif [[ $path == /zones\?per_page=100\&page=2 ]]; then
  if [[ $TEST_SCENARIO == missing-zone ]]; then
    printf '%s\n' '{"success":true,"result":[{"name":"wyattbubbylee.com","id":"zone-wyatt"},{"name":"extra.example","id":"zone-extra"}],"result_info":{"total_pages":2}}'
  else
    printf '%s\n' '{"success":true,"result":[{"name":"wyattbubbylee.com","id":"zone-wyatt"},{"name":"wayl.one","id":"zone-waylone"},{"name":"extra.example","id":"zone-extra"}],"result_info":{"total_pages":2}}'
  fi
elif [[ $method == POST ]]; then
  data=$(awk '/^data = / {sub(/^data = /, ""); print}' "$config" | jq -r fromjson)
  name=$(jq -r .name <<<"$data")
  printf '%s\t%s\t%s\n' "$path" "$name" 'record-created' >"$TEST_STATE/record"
  if [[ $TEST_SCENARIO == malformed-post ]]; then
    printf '%s\n' '{"success":true,"result":{}}'
  else
    printf '%s\n' '{"success":true,"result":{"id":"record-temporary"}}'
  fi
elif [[ $method == DELETE ]]; then
  printf 'DELETE %s\n' "$path" >>"$TEST_STATE/deletes.log"
  printf '%s\n' '{"success":true,"result":null}'
elif [[ $method == GET && $path == *'/dns_records?type=TXT&name='* ]]; then
  IFS=$'\t' read -r record_path record_name record_id <"$TEST_STATE/record" || true
  if [[ -n ${record_name-} && $path == *"name=$record_name" ]]; then
    zone=${path#/zones/}; zone=${zone%%/*}
    printf '{"success":true,"result":[{"id":"%s","name":"%s"}]}\n' "$record_id" "$record_name"
  else
    printf '%s\n' '{"success":true,"result":[]}'
  fi
else
  printf 'unexpected curl request: %s %s\n' "$method" "$path" >&2
  exit 1
fi
FAKE_CURL
chmod +x "$fake_bin"/*

run_workflow() {
  local scenario=$1 dir=$2
  export TEST_SCENARIO=$scenario TEST_STATE=$dir TEST_TOKEN=$token
  : >"$dir/clipboard.log"
  : >"$dir/curl.log"
  : >"$dir/deletes.log"
  printf '\nnull\nnull\n\n' >"$dir/input"
  if [[ $scenario != normal ]]; then
    if (cd "$dir" && PATH="$fake_bin:$PATH" "$workflow" <input >output 2>&1); then
      fail "$scenario workflow unexpectedly succeeded"
    fi
  else
    (cd "$dir" && PATH="$fake_bin:$PATH" "$workflow" <input >output 2>&1) \
      || fail "$scenario workflow failed"
  fi
}

success="$root/success"; mkdir "$success"; run_workflow normal "$success"
assert_file "$success/k8s/external-dns/manifests/cloudflare-api-token-sealed-secret.yaml"
assert_file "$success/k8s/external-dns/zone-ids.yaml"
assert_contains "$success/k8s/external-dns/manifests/cloudflare-api-token-sealed-secret.yaml" 'kind: SealedSecret'
cat >"$success/expected-zone-ids.yaml" <<'EXPECTED_ZONES'
# CAUTION: Zone access does not prove falcon tunnel coverage.
# Keep the canary label filter until every eligible host has a verified falcon route.
domainFilters:
  - extra.example
  - rhiannonwalker.com
  - wayl.one
  - waylonwalker.com
  - wyattbubbylee.com
extraArgs:
  zone-id-filter:
    - zone-extra
    - zone-rhiannon
    - zone-waylone
    - zone-waylon
    - zone-wyatt
EXPECTED_ZONES
cmp -s "$success/expected-zone-ids.yaml" "$success/k8s/external-dns/zone-ids.yaml" \
  || fail 'zone names and IDs are not deterministically paired'
assert_log_count 5 'POST /zones/zone-' "$success/curl.log"
assert_log_count 5 'DELETE /zones/zone-' "$success/curl.log"
assert_contains "$success/clipboard.log" clear
assert_not_contains "$success/output" "$token"
assert_not_contains "$success/curl.log" "$token"

missing="$root/missing"; mkdir "$missing"; run_workflow missing-zone "$missing"
assert_log_count 0 'POST /zones/' "$missing/curl.log"
assert_contains "$missing/clipboard.log" clear

malformed="$root/malformed"; mkdir "$malformed"; run_workflow malformed-post "$malformed"
assert_contains "$malformed/curl.log" 'GET /zones/zone-extra/dns_records?type=TXT&name='
assert_contains "$malformed/deletes.log" 'DELETE /zones/zone-extra/dns_records/record-created'
[[ ! -e $malformed/k8s/external-dns/zone-ids.yaml ]] || fail 'malformed POST wrote zone output'
[[ ! -e $malformed/k8s/external-dns/manifests/cloudflare-api-token-sealed-secret.yaml ]] \
  || fail 'malformed POST wrote sealed output'

printf 'PASS: external DNS Cloudflare secret workflow tests\n'
