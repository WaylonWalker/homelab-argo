#!/usr/bin/env bash
set -euo pipefail

# This workflow deliberately keeps the token in shell memory and pipes it
# directly into kubectl. Do not add tracing or debug output to this file.

readonly API_URL='https://api.cloudflare.com/client/v4'
readonly TOKEN_NAME='external-dns-falcon'
readonly OUTPUT_DIR='k8s/external-dns/manifests'
readonly SEALED_OUTPUT="$OUTPUT_DIR/cloudflare-api-token-sealed-secret.yaml"
readonly ZONE_OUTPUT='k8s/external-dns/zone-ids.yaml'
readonly CONTROLLER_NAME='sealed-secrets-controller'
readonly CONTROLLER_NAMESPACE='kube-system'
readonly LOCK_FILE="${TMPDIR:-/tmp}/homelab-argo-external-dns-secret.lock"
readonly -a REQUIRED_ZONES=(
  waylonwalker.com
  rhiannonwalker.com
  wyattbubbylee.com
  wayl.one
)

token=''
clipboard_reader=()
clipboard_writer=()
declare -a tracked_zone_ids=()
declare -a tracked_record_ids=()
declare -a tracked_record_names=()
declare -a managed_zones=()
secret_tmp=''
zones_tmp=''
secret_backup=''
zones_backup=''
secret_preexisting=false
zones_preexisting=false
install_started=false
install_complete=false
lock_fd=''

die() {
  printf 'Error: %s\n' "$1" >&2
  exit 1
}

cleanup() {
  local index zone_id record_id record_name response cleanup_id
  set +e

  if [[ "$install_started" == true && "$install_complete" != true ]]; then
    if [[ "$secret_preexisting" == true && -n "$secret_backup" ]]; then
      mv -f "$secret_backup" "$SEALED_OUTPUT"
      secret_backup=''
    else
      rm -f "$SEALED_OUTPUT"
    fi
    if [[ "$zones_preexisting" == true && -n "$zones_backup" ]]; then
      mv -f "$zones_backup" "$ZONE_OUTPUT"
      zones_backup=''
    else
      rm -f "$ZONE_OUTPUT"
    fi
    printf 'Restored the previous generated files after an incomplete update.\n' >&2
  fi

  [[ -z "$secret_tmp" ]] || rm -f "$secret_tmp"
  [[ -z "$zones_tmp" ]] || rm -f "$zones_tmp"
  [[ -z "$secret_backup" ]] || rm -f "$secret_backup"
  [[ -z "$zones_backup" ]] || rm -f "$zones_backup"
  for ((index=${#tracked_record_ids[@]} - 1; index >= 0; index--)); do
    zone_id=${tracked_zone_ids[index]}
    record_id=${tracked_record_ids[index]}
    record_name=${tracked_record_names[index]}
    [[ -n "$record_name" ]] || continue

    response=$(cf_request GET "/zones/$zone_id/dns_records?type=TXT&name=$record_name")
    if jq -e '.success == true and (.result | type) == "array"' >/dev/null 2>&1 <<<"$response"; then
      while IFS= read -r cleanup_id; do
        [[ -n "$cleanup_id" ]] || continue
        response=$(cf_request DELETE "/zones/$zone_id/dns_records/$cleanup_id")
        if jq -e '.success == true' >/dev/null 2>&1 <<<"$response"; then
          printf 'Cleaned up temporary DNS record %s in zone %s.\n' "$cleanup_id" "$zone_id" >&2
        else
          printf 'Warning: could not clean up temporary DNS record %s in zone %s.\n' "$cleanup_id" "$zone_id" >&2
        fi
      done < <(jq -r '.result[].id' <<<"$response")
    elif [[ -n "$record_id" ]]; then
      response=$(cf_request DELETE "/zones/$zone_id/dns_records/$record_id")
      jq -e '.success == true' >/dev/null 2>&1 <<<"$response" \
        || printf 'Warning: could not clean up temporary DNS record %s in zone %s.\n' "$record_id" "$zone_id" >&2
    else
      printf 'Warning: could not find temporary DNS record %s for cleanup.\n' "$record_name" >&2
    fi
    tracked_record_ids[index]=''
    tracked_record_names[index]=''
  done
  if ((${#clipboard_writer[@]})); then
    "${clipboard_writer[@]}" >/dev/null 2>&1 </dev/null
  fi
  if [[ -n "$lock_fd" ]]; then
    flock --unlock "$lock_fd"
    exec {lock_fd}>&-
  fi
  unset token
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

require_commands() {
  local command_name
  for command_name in kubectl kubeseal curl jq flock; do
    command -v "$command_name" >/dev/null 2>&1 || die "required command not found: $command_name"
  done

  if command -v wl-paste >/dev/null 2>&1 && command -v wl-copy >/dev/null 2>&1; then
    clipboard_reader=(wl-paste --no-newline)
    clipboard_writer=(wl-copy --clear)
  elif command -v xclip >/dev/null 2>&1; then
    clipboard_reader=(xclip -selection clipboard -o)
    clipboard_writer=(xclip -selection clipboard)
  elif command -v xsel >/dev/null 2>&1; then
    clipboard_reader=(xsel --clipboard --output)
    clipboard_writer=(xsel --clipboard --input)
  elif command -v pbpaste >/dev/null 2>&1 && command -v pbcopy >/dev/null 2>&1; then
    clipboard_reader=(pbpaste)
    clipboard_writer=(pbcopy)
  else
    die 'no clipboard read/clear pair found (need wl-clipboard, xclip, xsel, or pbpaste with pbcopy)'
  fi
}

acquire_lock() {
  exec {lock_fd}>"$LOCK_FILE"
  flock --nonblock "$lock_fd" \
    || die 'another external-dns-secret workflow is already running'
}

check_cluster() {
  kubectl cluster-info >/dev/null || die 'kubectl cannot access the current cluster'
  kubeseal --fetch-cert \
    --controller-name "$CONTROLLER_NAME" \
    --controller-namespace "$CONTROLLER_NAMESPACE" \
    >/dev/null || die 'cannot reach the live Sealed Secrets controller'
}

cf_request() {
  local method=$1 path=$2 data=${3-}
  if [[ -n "$data" ]]; then
    curl -fsS -X "$method" \
      --config <(printf 'header = "Authorization: Bearer %s"\nheader = "Content-Type: application/json"\ndata = %s\n' "$token" "$(printf '%s' "$data" | jq -Rs .)") \
      "$API_URL$path"
  else
    curl -fsS -X "$method" \
      --config <(printf 'header = "Authorization: Bearer %s"\n' "$token") \
      "$API_URL$path"
  fi
}

verify_token() {
  local response
  response=$(cf_request GET /user/tokens/verify) || die 'Cloudflare token verification request failed'
  jq -e '.success == true and .result.status == "active"' >/dev/null <<<"$response" \
    || die 'Cloudflare token is not valid and active'
  printf 'Cloudflare token verified and active.\n'
}

load_zones() {
  local page=1 response all_zones='[]' total_pages name count
  declare -gA zone_ids=()
  while :; do
    response=$(cf_request GET "/zones?per_page=100&page=$page") \
      || die "could not list Cloudflare zones (page $page)"
    jq -e '.success == true and (.result | type) == "array"' >/dev/null <<<"$response" \
      || die "Cloudflare returned an invalid zone list (page $page)"
    all_zones=$(jq -nc --argjson existing "$all_zones" --argjson response "$response" '$existing + $response.result')
    total_pages=$(jq -r '.result_info.total_pages' <<<"$response")
    ((page >= total_pages)) && break
    ((page += 1))
  done

  while IFS=$'\t' read -r name zone_id; do
    [[ -n "$name" && -n "$zone_id" ]] || continue
    [[ -z "${zone_ids[$name]+present}" ]] || die "Cloudflare returned zone $name more than once"
    zone_ids["$name"]=$zone_id
  done < <(jq -r '.[] | [.name, .id] | @tsv' <<<"$all_zones")

  count=$(jq 'length' <<<"$all_zones")
  printf 'Token can see %s Cloudflare zone(s).\n' "$count"
  for name in "${REQUIRED_ZONES[@]}"; do
    [[ -n "${zone_ids[$name]+present}" ]] || die "required zone is not visible to token: $name"
  done
  mapfile -t managed_zones < <(jq -r 'sort_by(.name)[] | .name' <<<"$all_zones")
  printf 'The generated configuration will manage these zones:\n'
  printf '  - %s\n' "${managed_zones[@]}"
}

prove_dns_write() {
  local zone zone_id record_name content response record_id run_id index
  run_id="$(date +%s%N)-$$-${RANDOM}"
  for zone in "${managed_zones[@]}"; do
    zone_id=${zone_ids[$zone]}
    record_name="_external-dns-secret-check-${run_id}.${zone}"
    content="external-dns-secret-check-${run_id}"
    tracked_zone_ids+=("$zone_id")
    tracked_record_ids+=('')
    tracked_record_names+=("$record_name")
    index=$((${#tracked_record_ids[@]} - 1))
    response=$(cf_request POST "/zones/$zone_id/dns_records" \
      "{\"type\":\"TXT\",\"name\":\"$record_name\",\"content\":\"$content\",\"ttl\":60}") \
      || die "DNS write test could not create a temporary TXT record in $zone"
    jq -e '.success == true and (.result.id | type) == "string"' >/dev/null <<<"$response" \
      || die "Cloudflare rejected temporary TXT record creation in $zone"
    record_id=$(jq -r '.result.id' <<<"$response")
    tracked_record_ids[index]=$record_id
    response=$(cf_request DELETE "/zones/$zone_id/dns_records/$record_id") \
      || die "DNS write test could not delete temporary TXT record $record_id in $zone"
    jq -e '.success == true' >/dev/null <<<"$response" \
      || die "Cloudflare rejected temporary TXT record deletion $record_id in $zone"
    tracked_record_ids[index]=''
    tracked_record_names[index]=''
    printf 'DNS create/delete verified for %s (record %s).\n' "$zone" "$record_id"
  done
}

generate_outputs() {
  local zone
  mkdir -p "$OUTPUT_DIR" "$(dirname "$ZONE_OUTPUT")"
  secret_tmp=$(mktemp "$OUTPUT_DIR/.cloudflare-api-token-sealed-secret.XXXXXX")
  zones_tmp=$(mktemp "$(dirname "$ZONE_OUTPUT")/.zone-ids.XXXXXX")

  printf '%s' "$token" |
    kubectl create secret generic external-dns-cloudflare \
      --namespace external-dns --from-file=api-token=/dev/stdin \
      --dry-run=client -o yaml |
    kubeseal --namespace external-dns --name external-dns-cloudflare -o yaml >"$secret_tmp" \
      || die 'could not generate the sealed Kubernetes Secret'
  kubeseal --validate \
    --controller-name "$CONTROLLER_NAME" \
    --controller-namespace "$CONTROLLER_NAMESPACE" \
    <"$secret_tmp" || die 'generated SealedSecret failed live-controller validation'

  {
    printf '# CAUTION: Zone access does not prove falcon tunnel coverage.\n'
    printf '# Keep the canary label filter until every eligible host has a verified falcon route.\n'
    printf 'domainFilters:\n'
    for zone in "${managed_zones[@]}"; do
      printf '  - %s\n' "$zone"
    done
    printf 'extraArgs:\n  zone-id-filter:\n'
    for zone in "${managed_zones[@]}"; do
      printf '    - %s\n' "${zone_ids[$zone]}"
    done
  } >"$zones_tmp"

  if [[ -e "$SEALED_OUTPUT" ]]; then
    secret_preexisting=true
    secret_backup=$(mktemp "$OUTPUT_DIR/.cloudflare-api-token-sealed-secret.backup.XXXXXX")
    cp -p "$SEALED_OUTPUT" "$secret_backup"
  fi
  if [[ -e "$ZONE_OUTPUT" ]]; then
    zones_preexisting=true
    zones_backup=$(mktemp "$(dirname "$ZONE_OUTPUT")/.zone-ids.backup.XXXXXX")
    cp -p "$ZONE_OUTPUT" "$zones_backup"
  fi

  install_started=true
  mv -f "$secret_tmp" "$SEALED_OUTPUT"
  secret_tmp=''
  mv -f "$zones_tmp" "$ZONE_OUTPUT"
  zones_tmp=''
  install_complete=true
  [[ -z "$secret_backup" ]] || rm -f "$secret_backup"
  [[ -z "$zones_backup" ]] || rm -f "$zones_backup"
  secret_backup=''
  zones_backup=''
  printf 'Wrote encrypted Secret: %s\nWrote zone filters: %s\n' "$SEALED_OUTPUT" "$ZONE_OUTPUT"
}

main() {
  require_commands
  acquire_lock
  check_cluster
  printf '%s\n' \
    "Create the Cloudflare token $TOKEN_NAME with:" \
    '  Permissions: Zone -> Zone -> Read; Zone -> DNS -> Edit' \
    '  Zone Resources: Include -> All zones' \
    '  The generated zone filters include every zone that the token can currently see.' \
    '  These four zones must be present:' \
    "    ${REQUIRED_ZONES[*]}" \
    '  wayl.one is included because cluster Ingresses use it and falcon routes *.wayl.one.' \
    '' \
    'The Cloudflare token page will open now.'
  if command -v xdg-open >/dev/null 2>&1; then
    xdg-open https://dash.cloudflare.com/profile/api-tokens >/dev/null 2>&1 \
      || printf 'Could not open the browser. Open: https://dash.cloudflare.com/profile/api-tokens\n'
  else
    printf 'Open: https://dash.cloudflare.com/profile/api-tokens\n'
  fi
  printf 'Press Enter when the token is on the clipboard.\n'
  read -r
  token=$("${clipboard_reader[@]}")
  [[ -n "$token" ]] || die 'clipboard is empty'
  [[ "$token" =~ ^[A-Za-z0-9._-]{20,256}$ ]] \
    || die 'clipboard does not contain a valid Cloudflare API token format'
  verify_token
  load_zones
  printf '%s\n' \
    "CAUTION: The next step creates and immediately deletes one temporary TXT record in each of ${#managed_zones[@]} zones." \
    'Press Enter to run the DNS write checks, or press Ctrl-C to stop.'
  read -r
  prove_dns_write
  generate_outputs
  stat "$SEALED_OUTPUT" "$ZONE_OUTPUT" 2>/dev/null || ls -l "$SEALED_OUTPUT" "$ZONE_OUTPUT"
  printf '%s\n' \
    'Next steps:' \
    "  helm template external-dns external-dns --repo https://kubernetes-sigs.github.io/external-dns/ --version 1.22.0 --namespace external-dns --values k8s/external-dns/values.yaml --values $ZONE_OUTPUT" \
    "  kubeseal --validate --controller-name $CONTROLLER_NAME --controller-namespace $CONTROLLER_NAMESPACE < $SEALED_OUTPUT" \
    '  Review and commit the encrypted Secret and zone filters. Do not apply the Secret manually.' \
    '  Check Argo: kubectl get application external-dns -n argocd' \
    '  Check Ingress status: kubectl get ingress -A' \
    '  Check ExternalDNS dry-run logs: kubectl logs -n external-dns deploy/external-dns --follow' \
    'Credentials and the Git commit are separate steps.'
}

main "$@"
